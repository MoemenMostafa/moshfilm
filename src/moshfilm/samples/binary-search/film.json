  "scenes": [
    {
      "id": "s1",
      "title": "The sorted row",
      "file": "scenes/s1.js",
      "length": 7.0,
      "pinned": false,
      "status": "ready",
      "voice": {
        "text": "Sixteen lockers stand in a row, and the numbers inside rise from left to right. Somewhere in here is 37.",
        "offset": 0.3,
        "pinned": false
      }
    },
    {
      "id": "s2",
      "title": "One by one",
      "file": "scenes/s2.js",
      "length": 7.0,
      "pinned": false,
      "status": "ready",
      "voice": {
        "text": "We could open them one by one from the left. It works, but in the worst case we open all sixteen.",
        "offset": 0.3,
        "pinned": false
      }
    },
    {
      "id": "s3",
      "title": "Open the middle",
      "file": "scenes/s3.js",
      "length": 8.0,
      "pinned": false,
      "status": "ready",
      "voice": {
        "text": "Instead, open the locker in the middle. It holds 52, which is too big, so every locker to its right is out.",
        "offset": 0.3,
        "pinned": false
      }
    },
    {
      "id": "s4",
      "title": "Halve what is left",
      "file": "scenes/s4.js",
      "length": 8.0,
      "pinned": false,
      "status": "ready",
      "voice": {
        "text": "Each look throws away about half of what remains: sixteen lockers, then seven, then three, then one.",
        "offset": 0.3,
        "pinned": false
      }
    },
    {
      "id": "s5",
      "title": "Found it",
      "file": "scenes/s5.js",
      "length": 7.0,
      "pinned": false,
      "status": "ready",
      "voice": {
        "text": "Four looks, and 37 is ours. Checking one by one would have taken five here, and up to sixteen.",
        "offset": 0.3,
        "pinned": false
      }
    },
    {
      "id": "s6",
      "title": "Why it scales",
      "file": "scenes/s6.js",
      "length": 8.0,
      "pinned": false,
      "status": "ready",
      "voice": {
        "text": "Double the lockers and you need only one more look. A million sorted items take about twenty.",
        "offset": 0.3,
        "pinned": false
      }
    }
  ],
